# ==========================================
# Shahyog Kart - Backend Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://shahyog-kart.vercel.app
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Local or Cloud e.g. Aiven, PlanetScale, Railway)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=shahyog_kart
DB_PORT=3306
DB_SSL=false

# Alternatively, Cloud Database Variables (Aiven / Render / Railway)
DATABASE_HOST=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=shahyog_kart
DATABASE_PORT=3306

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_shahyog_kart_2026_at_least_32_characters
JWT_EXPIRE=7d

# Google OAuth (Google Cloud Console Web Client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary Image Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Storage Fallback (Local)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5
