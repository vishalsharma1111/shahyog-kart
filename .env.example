# ==========================================
# Shahyog Kart - Master Environment Reference
# ==========================================

### Backend Environment Variables (Render / Cloud / Local)
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://shahyog-kart.vercel.app
CLIENT_URL=http://localhost:5173

# MySQL (Aiven / PlanetScale / Render / AWS RDS)
DATABASE_HOST=your-mysql-host.aivencloud.com
DATABASE_PORT=3306
DATABASE_USER=avnadmin
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=shahyog_kart
DB_SSL=true

# JWT Secret
JWT_SECRET=production_secure_jwt_secret_shahyog_kart_2026_xyz
JWT_EXPIRE=7d

# Google OAuth 2.0 Client ID (Backend verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary CDN Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

### Frontend Environment Variables (Vercel)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_APP_NAME="Shahyog Kart"
VITE_APP_TAGLINE="Shop with Purpose, Donate with Love."
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
